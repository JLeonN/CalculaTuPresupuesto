{
  "name": "calcula-tu-presupuesto",
  "version": "0.0.3",
  "description": "Aplicación responsive para calcular y gestionar presupuestos profesionales",
  "productName": "Calcula tu presupuesto",
  "author": "Leo",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,html,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path src-capacitor/android/.gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,html,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path src-capacitor/android/.gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "dev:android": "quasar dev -m capacitor -T android",
    "build": "quasar build",
    "build:android": "quasar build -m capacitor -T android",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@quasar/extras": "^2.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.5.0",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
